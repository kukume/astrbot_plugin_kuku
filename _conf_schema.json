{
  "rapid_key": {
    "description": "RapidAPI Key（BIN 卡头查询）",
    "type": "string",
    "default": ""
  },
  "openai_api_key": {
    "description": "OpenAI API Key",
    "type": "string",
    "default": ""
  },
  "openai_base_url": {
    "description": "OpenAI Base URL",
    "type": "string",
    "default": "https://api.openai.com/v1"
  },
  "openai_image_model": {
    "description": "OpenAI 图片模型",
    "type": "string",
    "default": "gpt-image-2"
  },
  "openai_video_model": {
    "description": "视频生成模型",
    "type": "string",
    "default": "grok-imagine-video"
  },
  "s3_region": {
    "description": "S3 Region",
    "type": "string",
    "default": ""
  },
  "s3_access_key_id": {
    "description": "S3 Access Key ID",
    "type": "string",
    "default": ""
  },
  "s3_secret_access_key": {
    "description": "S3 Secret Access Key",
    "type": "string",
    "default": ""
  },
  "s3_bucket": {
    "description": "S3 Bucket",
    "type": "string",
    "default": ""
  },
  "s3_endpoint_url": {
    "description": "S3 Endpoint URL",
    "type": "string",
    "default": ""
  },
  "socks_proxy_host": {
    "description": "SOCKS 代理 IP（留空则不使用代理）",
    "type": "string",
    "hint": "例如 127.0.0.1",
    "default": ""
  },
  "socks_proxy_port": {
    "description": "SOCKS 代理端口（0 表示不使用代理）",
    "type": "int",
    "hint": "例如 1080",
    "default": 0
  }
}
